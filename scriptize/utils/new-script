#!/usr/bin/env bash

set -euo pipefail

# Load the path to the templates repository. SCRIPTIZE_CONFIG overrides the install-time location.
config_file="${SCRIPTIZE_CONFIG:-/etc/script-templates/config}"
if [[ -f ${config_file} ]]; then
    # shellcheck source=/dev/null
    source "${config_file}"
else
    echo "Error: Configuration file not found. Please run install.sh" >&2
    exit 1
fi

if [[ -z "${TEMPLATE_REPO_PATH}" ]]; then
    echo "Error: TEMPLATE_REPO_PATH is not set in the config. Please re-run install.sh" >&2
    exit 1
fi

if [[ $# -ne 2 ]]; then
    echo "Usage: $(basename "$0") <bash|python> <project_name>"
    exit 1
fi

type="${1}"
proj_name="${2}"

if [[ -d "${proj_name}" ]]; then
    echo "Error: Directory '${proj_name}' already exists."
    exit 1
fi

echo "Creating new ${type} project: ${proj_name}"
mkdir -p "${proj_name}"
cd "${proj_name}"

assets_dir="${TEMPLATE_REPO_PATH}/scriptize/assets"

case "${type}" in
bash)
    script_name="${proj_name}.sh"
    cp "${assets_dir}/bash/template.sh" "./${script_name}"
    chmod +x "./${script_name}"

    # The template sources "<script dir>/utilities", so link the shared utilities there
    ln -s "${assets_dir}/bash/utilities" ./utilities

    echo "Created ${script_name}"
    echo "Created symlink to utilities/"
    echo "Your new project is ready in the './${proj_name}' directory."
    ;;
python)
    script_name="${proj_name}.py"
    cp "${assets_dir}/python/main.py" "./${script_name}"
    chmod +x "./${script_name}"
    ln -s "${assets_dir}/python/utilities" ./utilities
    echo "Created ${script_name}"
    echo "Created symlink to utilities/"
    echo "Remember to setup your python environment (e.g., venv)."
    ;;
*)
    cd .. && rm -r "${proj_name}" # cleanup
    echo "Error: Invalid type '${type}'. Choose 'bash' or 'python'." >&2
    exit 1
    ;;
esac

echo "Done. Happy scripting!"
