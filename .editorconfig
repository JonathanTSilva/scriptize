# EditorConfig
# http://EditorConfig.org

# Don't search any further up the directory tree
root = true

# Baseline
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Shell scripts
[{*.sh,*.bash,*.bats,new-script}]
indent_size = 4
max_line_length = 79
keep_padding = true             # shfmt: -kp
space_redirects = false         # shfmt: no -sr (matches existing code)
switch_case_indent = false      # shfmt: no -ci (matches existing code)
